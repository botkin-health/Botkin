# Botkin Environment Variables Example
# Copy this to .env and fill in your actual values

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_id
# Владелец данных Garmin: используется derived-шагами синка для имени per-user
# файлов (workouts_log_<id>.json). Без него сборка тренировок падает (#474).
BOTKIN_USER_ID=your_telegram_id
# Админ-доступ к ops-командам (/sync, /feedback_queue, /users, /block, /unblock).
# Список Telegram ID через запятую — можно несколько админов на стенд.
# Обратная совместимость: старая одиночная BOTKIN_ADMIN_ID тоже учитывается.
BOTKIN_ADMIN_IDS=your_telegram_id
# Секрет из setWebhook(secret_token=...) — проверяется на /telegram/webhook,
# защита от поддельных Update из docker-сети. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32

# WHOOP OAuth — подпись state (защита от привязки чужого аккаунта).
# openssl rand -hex 32. При отсутствии fallback на APPLE_HEALTH_TOKEN.
WHOOP_STATE_SECRET=generate_with_openssl_rand_hex_32

# OpenAI API Key (распознавание еды, голоса)
OPENAI_API_KEY=sk-proj-your_key_here

# Google Gemini API (работает из России)
GEMINI_API_KEY=your_gemini_key_here

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthvault
DB_USER=healthvault
DB_PASSWORD=your_password_here

# Application Settings
LOG_LEVEL=INFO
CACHE_DIR=/app/data/cache

# Лимиты LLM на пользователя (core/llm_budget.py). Админы и когорта owner — без лимитов.
# LLM_BUDGET_ENABLED=1
# LLM_USER_DAILY_BUDGET_USD=3        # $ за скользящие 24 часа по llm_usage_log
# LLM_GLOBAL_DAILY_BUDGET_USD=40     # аварийный стоп на всех лимитных пользователей, 0 — выкл
# LLM_RATE_LIMIT_COUNT=20            # сообщений в LLM за окно
# LLM_RATE_LIMIT_WINDOW_SEC=300
# LLM_BUDGET_EXEMPT_COHORTS=owner
